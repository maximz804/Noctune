
{
  "name": "noctune",
  "version": "0.2.0",
  "description": "NOCTUNE - Dark futuristic YouTube music player for Windows",
  "main": "main.js",
  "author": "Noctune Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.noctune.desktop",
    "productName": "NOCTUNE",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app/**/*",
      "assets/**/*",
      "noctune.png",
      "noctune.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "noctune.ico"
    },
    "portable": {
      "artifactName": "NOCTUNE-Portable-${version}.${ext}"
    }
  }
}
